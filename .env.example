# ─────────────────────────────────────────────────────────────
# E-World environment template. Copy to .env and fill in values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────────────
# Host ports are offset from the defaults so E-World can coexist with other
# local stacks (5432/6379/9000 are commonly taken). Change freely if free.
POSTGRES_USER=eworld
POSTGRES_PASSWORD=eworld_dev_password
POSTGRES_DB=eworld
POSTGRES_PORT=5433
DATABASE_URL=postgresql://eworld:eworld_dev_password@localhost:5433/eworld?schema=public

# ── Redis (presence, pub/sub, rate-limit, socket adapter) ──────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ── S3 / MinIO (assets, avatars, user uploads) ─────────────────
S3_ENDPOINT=http://localhost:9100
S3_PORT=9100
S3_CONSOLE_PORT=9101
S3_REGION=us-east-1
S3_ACCESS_KEY=eworld
S3_SECRET_KEY=eworld_dev_secret
S3_BUCKET=eworld-assets
S3_FORCE_PATH_STYLE=true

# ── Auth: Google OAuth 2.0 ─────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Auth: JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900           # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000      # 30 days (seconds)

# ── Server ─────────────────────────────────────────────────────
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
WORLD_SEED=420691337         # deterministic world generation seed

# ── Frontend (Next.js, public) ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_WORLD_SEED=420691337
